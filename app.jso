{
  "expo": {
    "name": "Mezbaan Restro",
    "slug": "mezbaan-restro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/icon.png",
    "scheme": "mezbaanrestro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/images/icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

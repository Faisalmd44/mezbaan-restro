{
  "expo": {
    "name": "Mezbaan",
    "slug": "mezbaan-restro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/icon.png",
    "scheme": "mezbaanrestro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "foregroundImage": "assets/images/icon.png", "backgroundColor": "#0A0A0B" },
      "edgeToEdgeEnabled": true,
      "package": "com.mezbaan.restro"
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "assets/images/favicon.png" },
    "plugins": [
      "expo-router", "expo-font", "expo-web-browser", "expo-secure-store",
      ["expo-splash-screen", { "image": "assets/images/splash-image.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#0A0A0B" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
